    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>요일</th>
            <th>조식 🥣</th>
            <th>석식 🍜</th>
            <th>사용 재료</th>
          </tr>
        </thead>
        <tbody>
          <!-- Week 1: 2주차 -->
          <tr class="week-label"><td colspan="4">🍔 2주차 (7/6~7/12) — 박사님 확정 식단 ✅</td></tr>
          <tr>
            <td class="day-label">월<span class="date"> 7/6</span></td>
